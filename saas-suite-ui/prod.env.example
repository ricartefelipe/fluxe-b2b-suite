# === fluxe-b2b-suite Frontends: variáveis de produção ===
# Configurar as mesmas variáveis nos 3 serviços (shop, admin-console, ops-portal)
# Produção com domínio próprio: substituir pelos URLs reais. Ver docs/URLS-PRODUCAO.md e GO-LIVE-VENDA.md.

# URLs dos backends em produção
# Com URLs https://, o build injeta /api/... no config.json (same-origin) e o Shop (Node) / Nginx
# (ops, admin) reencaminha para estes alvos — o browser nao recebe HTML da SPA em /api/*.
CORE_API_BASE_URL=https://core.seu-dominio.com
ORDERS_API_BASE_URL=https://orders.seu-dominio.com
PAYMENTS_API_BASE_URL=https://payments.seu-dominio.com

# Auth: hs256 só para demo local; produção deve usar oidc + Keycloak (ou equivalente).
AUTH_MODE=oidc

# Shop: opcional — e-mail da página Fale conosco e URL da documentação/ajuda
# SUPPORT_EMAIL=suporte@seudominio.com.br
# SUPPORT_DOCS_URL=https://docs.seudominio.com

# OIDC (obrigatório se AUTH_MODE=oidc). O issuer deve coincidir com Keycloak/realm.
# Nos backends (Core): OIDC_ISSUER_URI + OIDC_JWK_SET_URI + JWT alinhados ao mesmo realm.
# OIDC_ISSUER=https://auth.seudominio.com.br/realms/fluxe
# OIDC_CLIENT_ID=shop
# Nota: cada app pode usar um clientId diferente no Keycloak (shop / ops-portal / admin-console).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email

LOG_LEVEL=warn
APP_VERSION=1.0.0
